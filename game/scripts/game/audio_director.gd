class_name AudioDirector
extends Node

## Original, restrained gameplay audio (EPIC 0.4 Milestone E). Every cue is synthesised
## locally at startup from a small tone vocabulary — no external asset, no third-party
## sample, nothing downloaded. This keeps the project asset-free and IP-safe.
##
## Design:
##   * One `AudioStreamWAV` per cue, generated once into a bounded pool of `AudioStreamPlayer`
##     nodes (POOL_SIZE). A turn never allocates a player, so the node count is constant no
##     matter how long the session runs.
##   * `request(cue)` records the request unconditionally (so the real event path is testable
##     even when no audio device exists) and only plays when audio is available and unmuted.
##   * Safe on a headless / Dummy audio driver: the request is recorded, playback is skipped.
##
## Provenance: all cues are generated by `_synth_*` in this file from sine tones and simple
## envelopes. Regenerating the project produces identical samples (deterministic, no RNG).

const MIX_RATE := 22050
const POOL_SIZE := 6

## Cue vocabulary. Closely related events may share a cue, but world restoration, discovery
## and the first solve are deliberately distinct so the player can tell them apart.
const CUE_TURN := "turn"           # a legal cube turn
const CUE_REFUSED := "refused"     # an illegal / locked-axis move
const CUE_SOLVE := "solve"         # a completed objective
const CUE_WORLD := "world"         # a world-restoration reaction
const CUE_DISCOVERY := "discovery" # an item / clue discovery
const CUE_CHOICE := "choice"       # a recorded world choice
const CUE_NOX := "nox"             # Nox awakening / interaction

var muted := false
## Settings file used for the persisted mute preference; tests override it to isolate.
var settings_path := SaveManager.SETTINGS_PATH

## Observable request/play history — the real event path is asserted through these.
var last_cue := ""
var requests: Dictionary = {}
var plays: Dictionary = {}

var _players: Array = []
var _streams: Dictionary = {}
var _next := 0
var _audio_ready := false

func _ready() -> void:
        var s := SaveManager.load_settings(settings_path)
        muted = bool(s.get("audio_muted", false))
        _streams = _synth_all()
        _build_pool()

## Create the bounded player pool. On a Dummy/absent audio driver the streams are still
## generated (so requests stay testable) but no players are created and playback is a no-op.
func _build_pool() -> void:
        _players.clear()
        var driver := ""
        if AudioServer.has_method("get_driver_name"):
                driver = str(AudioServer.get_driver_name())
        _audio_ready = driver != "" and driver.to_lower() != "dummy"
        if not _audio_ready:
                return
        for i in range(POOL_SIZE):
                var p := AudioStreamPlayer.new()
                p.name = "Cue%d" % i
                p.bus = "Master"
                add_child(p)
                _players.append(p)

## Ask for a cue. Records the request always; plays only when available and unmuted.
## Returns true when a sound was actually started.
func request(cue: String) -> bool:
        if cue == "":
                return false
        last_cue = cue
        requests[cue] = int(requests.get(cue, 0)) + 1
        if muted or not _audio_ready or not _streams.has(cue):
                return false
        var p: AudioStreamPlayer = _players[_next]
        _next = (_next + 1) % _players.size()
        p.stream = _streams[cue]
        p.play()
        plays[cue] = int(plays.get(cue, 0)) + 1
        return true

## Total requests for a cue (0 when never requested). Used by tests and diagnostics.
func request_count(cue: String) -> int:
        return int(requests.get(cue, 0))

func play_count(cue: String) -> int:
        return int(plays.get(cue, 0))

## Number of pooled players (constant; proves the pool is bounded).
func pool_size() -> int:
        return _players.size()

func is_audio_ready() -> bool:
        return _audio_ready

## Persist and apply the mute preference. A change takes effect on the very next cue.
func set_muted(value: bool) -> void:
        muted = value
        SaveManager.update_settings({"audio_muted": muted}, settings_path)

## Number of distinct generated cues (one AudioStreamWAV per vocabulary entry).
func cue_count() -> int:
        return _streams.size()

# --- synthesis ---------------------------------------------------------------------------

func _synth_all() -> Dictionary:
        return {
                CUE_TURN: _to_wav(_tone(330.0, 0.07, 22.0, 0.28)),
                CUE_REFUSED: _to_wav(_mix(_tone(150.0, 0.11, 14.0, 0.3), _tone(157.0, 0.11, 14.0, 0.3))),
                CUE_SOLVE: _to_wav(_arpeggio([392.0, 523.25, 659.25, 783.99], 0.11, 10.0, 0.3)),
                CUE_WORLD: _to_wav(_swell(196.0, 0.5, 0.22)),
                CUE_DISCOVERY: _to_wav(_arpeggio([659.25, 880.0], 0.15, 8.0, 0.26)),
                CUE_CHOICE: _to_wav(_arpeggio([440.0, 440.0], 0.07, 20.0, 0.24)),
                CUE_NOX: _to_wav(_tone(220.0, 0.35, 4.0, 0.22)),
        }

## A single decaying sine tone. `decay` is the exponential rate; higher = shorter.
func _tone(freq: float, dur: float, decay: float, amp: float) -> PackedFloat32Array:
        var n := int(dur * MIX_RATE)
        var out := PackedFloat32Array()
        out.resize(n)
        for i in range(n):
                var t := float(i) / float(MIX_RATE)
                out[i] = sin(TAU * freq * t) * exp(-decay * t) * amp
        return out

## Sum two equal-length buffers (used to make the refused buzz slightly detuned/beating).
func _mix(a: PackedFloat32Array, b: PackedFloat32Array) -> PackedFloat32Array:
        var n: int = maxi(a.size(), b.size())
        var out := PackedFloat32Array()
        out.resize(n)
        for i in range(n):
                var v := 0.0
                if i < a.size():
                        v += a[i]
                if i < b.size():
                        v += b[i]
                out[i] = v
        return out

## A short sequence of decaying tones, concatenated (used for solve / discovery / choice).
func _arpeggio(freqs: Array, step: float, decay: float, amp: float) -> PackedFloat32Array:
        var out := PackedFloat32Array()
        for f in freqs:
                out.append_array(_tone(float(f), step, decay, amp))
        return out

## A slow-attack, slow-release chord swell for the world-restoration cue — softer and longer
## than the solve cue so the two never read as the same event.
func _swell(freq: float, dur: float, amp: float) -> PackedFloat32Array:
        var n := int(dur * MIX_RATE)
        var out := PackedFloat32Array()
        out.resize(n)
        for i in range(n):
                var t := float(i) / float(MIX_RATE)
                var env := sin(PI * clampf(t / dur, 0.0, 1.0))
                var v := sin(TAU * freq * t) + 0.5 * sin(TAU * freq * 1.5 * t) + 0.33 * sin(TAU * freq * 2.0 * t)
                out[i] = v / 1.83 * env * amp
        return out

## Convert a float buffer to a 16-bit mono WAV stream (little-endian, clamped).
func _to_wav(samples: PackedFloat32Array) -> AudioStreamWAV:
        var bytes := PackedByteArray()
        bytes.resize(samples.size() * 2)
        for i in range(samples.size()):
                var v := int(clampf(samples[i], -1.0, 1.0) * 32767.0)
                bytes.encode_s16(i * 2, v)
        var wav := AudioStreamWAV.new()
        wav.format = AudioStreamWAV.FORMAT_16_BITS
        wav.mix_rate = MIX_RATE
        wav.stereo = false
        wav.data = bytes
        return wav
