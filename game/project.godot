; CraftCube — Godot project (engine direction: Godot 4.x stable + GDScript, Android-first)
; See game/docs/ENGINE_AND_BUILD.md. Pinned engine: 4.7.2-stable.

config_version=5

[application]

config/name="CraftCube"
config/description="An original 3D twisting puzzle-adventure. Android-first."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/show_image=false

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1

[physics]

common/physics_ticks_per_second=60
