{
  "schemaVersion": "0.1.0",
  "registryId": "ai04.interaction.terminology",
  "status": "PROPOSED",
  "owner": "AI-04",
  "note": "PROPOSED stable-ID stems for AI-04 runtime interaction. Not released. Mirrors 03_INTERACTION_TERMINOLOGY.md and 09_CONTRACT_PROPOSAL_INTERACTION_COMMAND_v0.1.0.md. Validated by scripts/validate_ai04_phase00.py.",
  "idPattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
  "namespacesOwned": ["gesture", "interaction", "camera", "haptic", "puzzle", "world", "equipment"],
  "namespacesReservedByOthers": {
    "game": "AI-02 / AI-13 (existing examples: game.bloom.started)",
    "companion": "AI-06 (existing example: companion.ability.used)",
    "biome": "AI-02 / AI-05 (existing example: biome.overworld.meadow)",
    "creature": "AI-06",
    "chapter": "AI-03 / AI-09",
    "event": "AI-13 governance"
  },
  "gestures": [
    { "id": "gesture.twist",    "term": "Twist",         "definition": "Single-finger drag starting on a Face that rotates one Layer by a quarter turn." },
    { "id": "gesture.orbit",    "term": "Orbit",         "definition": "Single-finger drag starting off the Cube that rotates the camera around the Cube." },
    { "id": "gesture.zoom",     "term": "Zoom",          "definition": "Two-finger pinch/spread changing camera distance within the Comfort Envelope." },
    { "id": "gesture.tap",      "term": "Tap",           "definition": "Down and up within TAP_MS without exceeding TAP_MOVE_PX." },
    { "id": "gesture.hold",     "term": "Hold",          "definition": "Stationary touch beyond HOLD_MS; inspect/preview only, never commits a Twist." },
    { "id": "gesture.flick",    "term": "Flick",         "definition": "Twist released above FLICK_VEL_DEG_PER_S; commits without full travel." },
    { "id": "gesture.cancel",   "term": "Cancel",        "definition": "Gesture ended inside cancel band, by OS touch-cancel, or by a second finger during a Twist." },
    { "id": "gesture.reorient", "term": "Cube Reorient", "definition": "Two-finger drag on the Cube rotating the whole Cube; camera unchanged." }
  ],
  "intents": ["puzzle", "camera", "world", "equipment", "ui_passthrough", "undecided"],
  "commands": [
    { "id": "puzzle.layer.twist",       "stateChanging": true,  "consumer": "AI-02" },
    { "id": "puzzle.cube.reorient",     "stateChanging": "UNKNOWN", "consumer": "AI-04 / AI-02" },
    { "id": "puzzle.tile.tap",          "stateChanging": "domain-decides", "consumer": "AI-02 / AI-03" },
    { "id": "puzzle.preview.request",   "stateChanging": false, "consumer": "AI-02" },
    { "id": "camera.orbit.delta",       "stateChanging": false, "consumer": "AI-04" },
    { "id": "camera.zoom.delta",        "stateChanging": false, "consumer": "AI-04" },
    { "id": "camera.recenter",          "stateChanging": false, "consumer": "AI-04" },
    { "id": "world.anchor.tap",         "stateChanging": "domain-decides", "consumer": "AI-02 / AI-03" },
    { "id": "world.anchor.hold",        "stateChanging": false, "consumer": "AI-02 / AI-07" },
    { "id": "equipment.arm",            "stateChanging": false, "consumer": "AI-04" },
    { "id": "equipment.disarm",         "stateChanging": false, "consumer": "AI-04" },
    { "id": "equipment.use",            "stateChanging": true,  "consumer": "AI-02" },
    { "id": "equipment.channel.begin",  "stateChanging": true,  "consumer": "AI-02", "conditional": "only if an approved item declares channelled use" },
    { "id": "equipment.channel.end",    "stateChanging": true,  "consumer": "AI-02", "conditional": "only if an approved item declares channelled use" }
  ],
  "reservedNotProposed": [
    { "id": "puzzle.assist.request", "reason": "Depends on AI-03/AI-01 Phase 00 decision on assist features and AI-09 IP-safe naming. Reserved so no other stem is taken; NOT part of the proposed command catalog." }
  ],
  "notifications": [
    "interaction.intent.puzzle",
    "interaction.intent.camera",
    "interaction.intent.world",
    "interaction.intent.equipment",
    "interaction.intent.ui_passthrough",
    "interaction.intent.undecided",
    "interaction.preview.shown",
    "interaction.preview.hidden",
    "interaction.command.committed",
    "interaction.command.rejected",
    "interaction.settle.started",
    "interaction.settle.completed",
    "interaction.lock.begin",
    "interaction.lock.end",
    "interaction.recovery.completed",
    "camera.framing.home",
    "camera.framing.reaction",
    "camera.comfort.envelope"
  ],
  "haptics": [
    { "id": "haptic.puzzle.twist_tick",    "intensityClass": "light",  "modifier": null,      "firesOn": "detent pass during drag" },
    { "id": "haptic.puzzle.twist_commit",  "intensityClass": "medium", "modifier": null,      "firesOn": "Twist commit" },
    { "id": "haptic.puzzle.twist_reject",  "intensityClass": "light",  "modifier": "double",  "firesOn": "domain typed failure" },
    { "id": "haptic.world.answer",         "intensityClass": "strong", "modifier": null,      "firesOn": "world reaction begins (domain-confirmed)" },
    { "id": "haptic.world.anchor_touch",   "intensityClass": "light",  "modifier": null,      "firesOn": "touch on interactable Anchor" },
    { "id": "haptic.equipment.use",        "intensityClass": "medium", "modifier": null,      "firesOn": "equipment.use accepted" },
    { "id": "haptic.discovery.found",      "intensityClass": "strong", "modifier": "pattern", "firesOn": "discovery recorded (AI-03 DiscoveryDefinition event); once per id per profile via domain flag" }
  ],
  "intensityClasses": ["light", "medium", "strong"],
  "intensityModifiers": ["double", "pattern"],
  "tunables": {
    "note": "Initial hypotheses, not measured. Units: dp, ms, deg, deg/s. Single source for all AI-04 thresholds.",
    "TAP_MS": 180,
    "TAP_MOVE_PX": 8,
    "HOLD_MS": 350,
    "TWIST_START_PX": 12,
    "ORBIT_START_PX": 10,
    "TWIST_COMMIT_DEG": 45,
    "TWIST_CANCEL_DEG": 30,
    "FLICK_VEL_DEG_PER_S": 240,
    "EDGE_INSET_DP": 24,
    "REACTION_FRAMING_MAX_MS": 1200,
    "MAX_PLAUSIBLE_DELTA_DP": 400,
    "FLICK_WINDOW_MS": 80,
    "HITCH_MS": 100
  },
  "forbiddenTerms": ["block", "mine", "hotbar", "crosshair", "sticker", "minecraft", "creeper", "redstone", "steve"]
}
